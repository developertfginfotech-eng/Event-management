# Server Configuration
NODE_ENV=development
PORT=5003

# CORS - Allowed Origins
ADMIN_PANEL_URL=http://localhost:5173
MOBILE_APP_URL=

# Database
MONGODB_URI=mongodb://localhost:27017/event-management

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# Email Configuration (Optional - for sending emails to leads)
# Leave empty to use FREE Ethereal Email (test mode)
# Or configure Gmail/SendGrid/Mailgun for real email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Event Management System

# Example for Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password

# Example for SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your_sendgrid_api_key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
